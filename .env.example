# =============================================================================
# .env.example — DeepSeek R1 API Infrastructure
# =============================================================================
# Copy to .env and fill in your values:
#   cp .env.example .env
# NEVER commit .env to git.
# =============================================================================

# ─── SF Compute ───────────────────────────────────────────────────────────────
# Get from: https://sfcompute.com/dashboard/api-keys
SFCOMPUTE_API_KEY=your_sfcompute_api_key_here
SF_ZONE=landsend

# ─── HuggingFace ──────────────────────────────────────────────────────────────
# Get from: https://huggingface.co/settings/tokens
# Must have read access to deepseek-ai/DeepSeek-R1-Distill-Llama-70B
HF_TOKEN=hf_your_token_here

# ─── AWS ──────────────────────────────────────────────────────────────────────
# IAM user needs: APIGateway, Lambda, DynamoDB, CloudWatch, Secrets Manager,
# IAM role creation, SNS
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_DEFAULT_REGION=us-east-1

# ─── API Auth (for clients calling your API) ──────────────────────────────────
# This key is what your API consumers put in the x-api-key header
# Generate with: openssl rand -hex 32
DEEPSEEK_API_KEY=your_secret_api_key_for_clients_here

# ─── Cloudflare (optional, for custom domain) ─────────────────────────────────
# Get from: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ZONE_ID=your_zone_id_here
CLOUDFLARE_RECORD_NAME=api.deepseek  # → api.deepseek.yourdomain.com

# ─── Model config ─────────────────────────────────────────────────────────────
MODEL_NAME=deepseek-ai/DeepSeek-R1-Distill-Llama-70B
TENSOR_PARALLEL_SIZE=2
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.95

# ─── Node config ──────────────────────────────────────────────────────────────
NODE_COUNT=1           # How many H100 nodes to provision
INSTANCE_TYPE=h100-80gb-2x
PRICE_CAP=2.00         # Max USD/GPU-hr

# ─── SSH ──────────────────────────────────────────────────────────────────────
# Path to SSH private key for connecting to SF Compute nodes
SSH_KEY=~/.ssh/id_ed25519
